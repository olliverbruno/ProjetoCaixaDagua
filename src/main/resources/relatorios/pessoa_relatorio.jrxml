<!-- Created with Jaspersoft Studio version 7.0.8.final using JasperReports Library version 7.0.8-6f896111  -->
<jasperReport name="Relatorio_Pessoas" language="java" pageWidth="595" pageHeight="842" columnWidth="555" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20" uuid="4324e6b5-4ef3-4c15-9f36-d279b2988d8a">
    <property name="com.jaspersoft.studio.data.sql.tables" value=""/>
    <property name="com.jaspersoft.studio.data.defaultdataadapter" value="New Data Adapter"/>
    <!--a consulta so serve pro preview do studio, no sistema os dados vem do service-->
    <query language="SQL"><![CDATA[SELECT p.id, p.nome, p.cpf, p.telefone, p.cidade, p.uf,
	CASE WHEN c.id IS NOT NULL THEN 'Cliente' ELSE 'Funcionario' END AS "_THIS"
FROM pessoa p
LEFT JOIN cliente c ON c.id = p.id]]></query>
    <field name="id" class="java.lang.Long"/>
    <field name="nome" class="java.lang.String"/>
    <field name="cpf" class="java.lang.String"/>
    <field name="telefone" class="java.lang.String"/>
    <field name="cidade" class="java.lang.String"/>
    <field name="uf" class="java.lang.Object"/>
    <!--_THIS e o proprio objeto (Cliente ou Funcionario), no studio vem o texto da consulta-->
    <field name="_THIS" class="java.lang.Object"/>
    <sortField name="nome"/>
    <variable name="tipo" class="java.lang.String" calculation="Nothing">
        <expression><![CDATA[($F{_THIS} instanceof String ? (String) $F{_THIS} : $F{_THIS}.getClass().getSimpleName()).replace("Funcionario", "Funcionário")]]></expression>
    </variable>
    <variable name="clientes" class="java.lang.Integer" calculation="Count">
        <expression><![CDATA["Cliente".equals($V{tipo}) ? Boolean.TRUE : null]]></expression>
    </variable>
    <variable name="funcionarios" class="java.lang.Integer" calculation="Count">
        <expression><![CDATA["Funcionário".equals($V{tipo}) ? Boolean.TRUE : null]]></expression>
    </variable>
    <background/>
    <title height="80">
        <element kind="frame" uuid="d58837de-00d7-4e0a-9599-8358ab43b807" x="-20" y="-20" width="595" height="88" backcolor="#1E5AA8" mode="Opaque">
            <element kind="staticText" uuid="551f24d9-aa92-4503-bf8b-f80ef5692a7d" x="20" y="18" width="360" height="30" forecolor="#FFFFFF" fontSize="22.0" bold="true">
                <text><![CDATA[Relatório de Pessoas]]></text>
            </element>
            <element kind="staticText" uuid="f17689ec-f922-432a-888b-3087532eb444" x="20" y="50" width="360" height="20" forecolor="#DCE7F7" fontSize="12.0">
                <text><![CDATA[Gerenciador de Caixas d'Água]]></text>
            </element>
            <element kind="staticText" uuid="0b6a3f61-2d1e-4c62-9d55-3c1f0f5d8a10" x="395" y="30" width="180" height="16" forecolor="#DCE7F7" fontSize="10.0" hTextAlign="Right">
                <text><![CDATA[Gerado em]]></text>
            </element>
            <element kind="textField" uuid="083a97e7-6e20-4bea-a651-57442ac7cfec" x="395" y="46" width="180" height="20" forecolor="#FFFFFF" fontSize="12.0" bold="true" hTextAlign="Right" pattern="dd/MM/yyyy HH:mm">
                <expression><![CDATA[new java.util.Date()]]></expression>
            </element>
        </element>
    </title>
    <columnHeader height="24">
        <element kind="frame" uuid="62f35002-b066-44e4-bdb8-ecccee15413b" x="0" y="0" width="555" height="24" backcolor="#2B3A55" mode="Opaque">
            <element kind="staticText" uuid="1a1e2a0c-5b0e-4b3e-9a51-0e6c1a7d2b01" x="8" y="0" width="162" height="24" forecolor="#FFFFFF" fontSize="10.0" bold="true" vTextAlign="Middle">
                <text><![CDATA[Nome]]></text>
            </element>
            <element kind="staticText" uuid="1a1e2a0c-5b0e-4b3e-9a51-0e6c1a7d2b02" x="170" y="0" width="100" height="24" forecolor="#FFFFFF" fontSize="10.0" bold="true" vTextAlign="Middle">
                <text><![CDATA[CPF]]></text>
            </element>
            <element kind="staticText" uuid="1a1e2a0c-5b0e-4b3e-9a51-0e6c1a7d2b03" x="270" y="0" width="80" height="24" forecolor="#FFFFFF" fontSize="10.0" bold="true" vTextAlign="Middle">
                <text><![CDATA[Tipo]]></text>
            </element>
            <element kind="staticText" uuid="1a1e2a0c-5b0e-4b3e-9a51-0e6c1a7d2b04" x="350" y="0" width="100" height="24" forecolor="#FFFFFF" fontSize="10.0" bold="true" vTextAlign="Middle">
                <text><![CDATA[Telefone]]></text>
            </element>
            <element kind="staticText" uuid="1a1e2a0c-5b0e-4b3e-9a51-0e6c1a7d2b05" x="450" y="0" width="105" height="24" forecolor="#FFFFFF" fontSize="10.0" bold="true" vTextAlign="Middle">
                <text><![CDATA[Cidade/UF]]></text>
            </element>
        </element>
    </columnHeader>
    <detail>
        <band height="22">
            <!--linha sim linha nao fica cinza-->
            <element kind="frame" uuid="7accc1ba-e75f-4c54-9da4-e872ff7d9479" x="0" y="0" width="555" height="22" backcolor="#F1F4F9" mode="Opaque">
                <printWhenExpression><![CDATA[$V{REPORT_COUNT} % 2 == 0]]></printWhenExpression>
            </element>
            <element kind="line" uuid="7accc1ba-e75f-4c54-9da4-e872ff7d9480" x="0" y="21" width="555" height="1" forecolor="#E1E6EE"/>
            <element kind="textField" uuid="324e9a19-e146-4a38-9da9-ffa70a6f52e1" x="8" y="0" width="162" height="22" fontSize="10.0" vTextAlign="Middle" forecolor="#1D2433">
                <expression><![CDATA[$F{nome}]]></expression>
            </element>
            <element kind="textField" uuid="324e9a19-e146-4a38-9da9-ffa70a6f52e2" x="170" y="0" width="100" height="22" fontSize="10.0" vTextAlign="Middle" forecolor="#1D2433">
                <!--coloca ponto e traco no cpf-->
                <expression><![CDATA[$F{cpf} != null && $F{cpf}.length() == 11 ? $F{cpf}.substring(0, 3) + "." + $F{cpf}.substring(3, 6) + "." + $F{cpf}.substring(6, 9) + "-" + $F{cpf}.substring(9) : $F{cpf}]]></expression>
            </element>
            <element kind="textField" uuid="324e9a19-e146-4a38-9da9-ffa70a6f52e3" x="270" y="0" width="80" height="22" fontSize="10.0" bold="true" vTextAlign="Middle" forecolor="#1E5AA8">
                <expression><![CDATA[$V{tipo}]]></expression>
            </element>
            <element kind="textField" uuid="324e9a19-e146-4a38-9da9-ffa70a6f52e4" x="350" y="0" width="100" height="22" fontSize="10.0" vTextAlign="Middle" forecolor="#1D2433">
                <expression><![CDATA[$F{telefone}]]></expression>
            </element>
            <element kind="textField" uuid="324e9a19-e146-4a38-9da9-ffa70a6f52e5" x="450" y="0" width="105" height="22" fontSize="10.0" vTextAlign="Middle" forecolor="#1D2433">
                <expression><![CDATA[$F{cidade} + "/" + $F{uf}]]></expression>
            </element>
        </band>
    </detail>
