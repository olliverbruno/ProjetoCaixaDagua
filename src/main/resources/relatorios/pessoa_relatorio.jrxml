    <summary height="40">
        <element kind="textField" uuid="5c1d2e3f-4a5b-4c6d-8e7f-90a1b2c3d4e5" x="0" y="14" width="555" height="20" fontSize="11.0" bold="true" forecolor="#1D2433">
            <expression><![CDATA["Total: " + $V{REPORT_COUNT} + " pessoa(s) — " + $V{clientes} + " cliente(s) e " + $V{funcionarios} + " funcionário(s)"]]></expression>
        </element>
    </summary>
